# Konfigurasi server
PORT=3000
SESSION_SECRET=ganti-dengan-teks-acak-panjang
SEED_PASSWORD=GantiPasswordAwal#2026
GOOGLE_CLIENT_ID=
# Login Google lewat Firebase (disarankan). Bila keempat nilai ini diisi, tombol "Lanjutkan dengan Google" memakai Firebase
# dan GOOGLE_CLIENT_ID di atas tidak dipakai. Nilainya dari Firebase Console > Project settings > Your apps > Web app.
# Nilai ini bukan rahasia (memang tampil di browser).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
SITE_URL=http://localhost:3000

# MySQL / XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=karua_areum

# ---- Virtual Try-On AI (Hugging Face Gradio) ----
# Token opsional. Wajib untuk Space private / kuota HF yang lebih tinggi.
HF_TOKEN=
# Space HairFastGAN resmi (bisa diganti dengan Space milik sendiri).
HF_SPACE_ID=AIRI-Institute/HairFastGAN
# Isi bila memakai endpoint Gradio sendiri, mis. http://127.0.0.1:7860
HF_SPACE_URL=
# auto | hairfastgan | fallback
VTO_PROVIDER=auto
# Provider cadangan (Space Gradio nyata, bukan simulasi). Kosongkan untuk menonaktifkan.
VTO_FALLBACK_SPACE_ID=Ciraaa/Virtual_Hair_stylist
VTO_FALLBACK_SPACE_URL=
VTO_CONNECT_TIMEOUT_MS=25000
VTO_RESIZE_TIMEOUT_MS=45000
VTO_TIMEOUT_MS=120000
VTO_PRIMARY_COOLDOWN_MS=300000
VTO_MAX_UPLOAD_MB=2
# 1 = coba align_face bawaan Space (Space resmi saat ini bermasalah untuk align)
VTO_ALIGN=0

# ---- Pembayaran online (Midtrans Snap, mode sandbox) ----
# Kosongkan MIDTRANS_SERVER_KEY untuk menonaktifkan bayar online (kasir tetap bisa mencatat tunai/QRIS).
# Ambil dari dashboard.sandbox.midtrans.com > Settings > Access Keys. JANGAN taruh di frontend atau git.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Persen yang dibayar online (100 = lunas). Ubah bila mitra memutuskan uang muka, mis. 30.
BAYAR_ONLINE_PERSEN=100

# ---- Promo & batas booking ----
# Promo "potongan Rp10.000 pukul 12.00-16.00" (PRD 1.1). Berlaku untuk layanan rambut berharga tetap. PROMO_POTONGAN=0 mematikan promo.
PROMO_POTONGAN=10000
PROMO_JAM_MULAI=12:00
PROMO_JAM_SELESAI=16:00
# Booking aktif (menunggu/dikonfirmasi) maksimal per pelanggan, supaya slot tidak ditumpuk.
MAKS_BOOKING_AKTIF=3

# NODE_ENV=production
